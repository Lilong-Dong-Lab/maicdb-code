# SQLite databases (generated at runtime; the schema.sql dump IS tracked)
*.db
*.sqlite
*.sqlite3

# Jupyter
.ipynb_checkpoints/

# Data (large files - consider git-lfs for production)
data/raw/*.csv
data/raw/*.json
*.h5
*.hdf5

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.local
*.pem
*.key

# Logs
*.log
logs/

# release artifacts override the sqlite ignore
!db/maicdb.sqlite

# session agent tooling (skills, agent config, skill lockfile) — machine-
# local; flip to tracked if the team should share them. Exception (retro
# 2026-10-26): settings.json + hooks/ are tracked — team-wide agent
# guardrails (chained gh pr create+merge block).
.agents/
.claude/*
!/.claude/settings.json
!/.claude/hooks/
skills-lock.json

# Agent scratch space (session experiments, captured values) — machine-local;
# the vault repo already ignores its own
.scratch/

# firecrawl plugin cache (web-scrape artifacts from agent sessions) — machine-local
.firecrawl/

# Site build outputs (site/build.py default; generated, never committed)
site/_data/
site/_site/

# Playwright MCP artifacts (a11y snapshots from browser-verification sessions) — machine-local
.playwright-mcp/
